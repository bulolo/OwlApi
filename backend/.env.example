# ==============================================================================
# OwlApi 环境变量配置模板
# ==============================================================================
# 使用说明:
#   生产环境: make prod-init  → 复制到 deploy/.env，按需修改
#   开发环境: make dev-init   → 复制到 backend/.env，自动替换为本地地址
#
# ⚠️  本文件被 docker compose 通过 env_file: 直接注入。
#     env_file 解析与 shell 不同：value 后的 # 注释行为不稳定，
#     **请勿使用行内注释**，注释一律放到上一行。
# ==============================================================================

# ------------------------------------------------------------------------------
# 数据库配置
# 🔒 生产环境务必修改密码！
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=owlapi
DATABASE_URL=postgres://postgres:postgres@postgres:5432/owlapi?sslmode=disable

# ------------------------------------------------------------------------------
# 后端服务配置
# ------------------------------------------------------------------------------
OWLAPI_HTTP_PORT=:3000
OWLAPI_GRPC_PORT=:9090
OWLAPI_LOG_LEVEL=info

# 🔒 生产环境务必修改！建议: openssl rand -hex 32
OWLAPI_JWT_SECRET=change-me-in-production

# 开发环境改为: http://localhost:8001
OWLAPI_CORS_ORIGIN=https://admin.owlapi.cn

# ------------------------------------------------------------------------------
# 版本与授权 (Edition & License)
# community (开源 / 单租户) | enterprise (企业 / 多租户)
# 企业版许可证：CE 模式留空；EE 模式必填
# ------------------------------------------------------------------------------
OWLAPI_EDITION=community

# ------------------------------------------------------------------------------
# SDK Builder Sidecar (EE 专用)
# 给 "客户端 SDK → 发布到 GitLab" 功能用的代码生成服务。
# 同一 compose 部署时无需设置（默认走 docker service DNS）。
# 独立部署 / K8s 多 pod 场景需要显式覆盖。
# ------------------------------------------------------------------------------
# OWLAPI_SDK_BUILDER_URL=http://sdkbuilder:7100

# ------------------------------------------------------------------------------
# Gateway 配置
# 🔒 OWLAPI_GATEWAY_TOKEN 生产环境务必修改！建议: openssl rand -hex 16
# ------------------------------------------------------------------------------
OWLAPI_SERVER_URL=dns:///backend:9090
OWLAPI_GATEWAY_ID=1
OWLAPI_GATEWAY_TOKEN=gw_change-me-in-production
OWLAPI_TENANT_ID=1

# ------------------------------------------------------------------------------
# 前端配置
# 开发环境改为: http://localhost:3000
# ------------------------------------------------------------------------------
PUBLIC_API_URL=https://api.owlapi.cn

# ------------------------------------------------------------------------------
# 时区
# ------------------------------------------------------------------------------
TZ=Asia/Shanghai
